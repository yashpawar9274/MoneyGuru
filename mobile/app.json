{
  "expo": {
    "name": "MONEY.FYI",
    "slug": "money-fyi",
    "scheme": "moneyfyi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": { "supportsTablet": false, "bundleIdentifier": "app.moneyfyi" },
    "android": {
      "package": "app.moneyfyi",
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#09090b" }
    },
    "web": { "bundler": "metro" },
    "plugins": ["expo-router", "expo-image-picker", "expo-localization"],
    "extra": {
      "apiBaseUrl": "https://mmoneyguru.lovable.app"
    }
  }
}
